# Copy to .env.local and fill in. .env.local is git-ignored, so the password
# stays on this machine and is never committed.
#
# The mailbox is hello@refuge61.com at one.com, created 2026-09-05. Sending
# through the site's own mailbox — rather than a generic script or a third
# party — is what keeps enquiry emails out of guests' spam folders.

SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=hello@refuge61.com
SMTP_PASS=

# Who receives the enquiries. Comma-separated for both hosts.
LETS_TALK_TO=bjorn@refuge61.com,mathieu@refuge61.com

# What guests see in the From line.
LETS_TALK_FROM=REFUGE61 <hello@refuge61.com>
